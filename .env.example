# Environment Variables Template
# Copy this file to .env.local and fill in the actual values

# Supabase Configuration
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment Configuration (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Site Configuration  
NEXT_PUBLIC_SITE_URL=https://whitedge-lms.vercel.app/

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Additional Security Variables (if needed)
# JWT_SECRET=your_jwt_secret_here
# ENCRYPTION_KEY=your_encryption_key_here

# Meta Pixel / Conversions API
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your_meta_pixel_id
# Optional second pixel (PageView + Lead fire to both)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID_2=your_second_meta_pixel_id
FACEBOOK_CAPI_ACCESS_TOKEN=your_meta_conversions_api_access_token
# Optional CAPI token for the second pixel/dataset
FACEBOOK_CAPI_ACCESS_TOKEN_2=your_second_meta_conversions_api_access_token
# Optional: use only while validating in Events Manager Test Events
# FACEBOOK_CAPI_TEST_EVENT_CODE=TEST12345
# FACEBOOK_CAPI_TEST_EVENT_CODE_2=TEST12345

# CRM (Prisma on Supabase Postgres).
# DATABASE_URL is the pooled connection (port 6543). DIRECT_URL is the session connection (port 5432).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
AUTH_SECRET=generate-a-long-random-string
NEXTAUTH_SECRET=generate-a-long-random-string
# Optional. Required in production for /api/cron/digest
CRON_SECRET=generate-a-long-random-string
# Set to true to run the daily digest inside the Node process (08:00 Asia/Kolkata by default)
CRON_ENABLED=false
CRON_SCHEDULE="0 8 * * *"
# Leave SMTP unset to log digests to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CRM <crm@example.com>"
