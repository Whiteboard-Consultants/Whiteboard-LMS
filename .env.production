# WhitedgeLMS Production Environment Configuration
# 
# This template should be used to configure the production environment.
# All values must be set via secure environment variable management system.
# DO NOT commit actual values to this file.
#
# For deployment, use one of these approaches:
# 1. Environment variables set in deployment platform (Vercel, Railway, etc.)
# 2. Secrets manager (AWS Secrets Manager, GitHub Secrets, etc.)
# 3. Environment-specific CI/CD configuration

# ============================================================================
# SUPABASE CONFIGURATION (Production Database & Auth)
# ============================================================================
# Set in Vercel environment variables only - DO NOT commit actual keys
# Get these from: https://supabase.com/dashboard/project/[project-id]/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (Server-side only - CRITICAL: Don't expose)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# SITE CONFIGURATION - UPDATE THIS!
# ============================================================================
# CRITICAL: Update this to your Vercel domain
NEXT_PUBLIC_SITE_URL=https://whiteboard-lms.vercel.app
NEXT_PUBLIC_APP_URL=https://whiteboard-lms.vercel.app

# Site URL for local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ============================================================================
# RAZORPAY CONFIGURATION
# ============================================================================
# Set in Vercel environment variables only - DO NOT commit actual keys
RAZORPAY_KEY_ID=your_razorpay_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_live_key_secret

# ============================================================================
# AI/ML SERVICES (Google Gemini)
# ============================================================================
# Get this from: https://aistudio.google.com/app/apikey

# ============================================================================
# GOOGLE AI & APIs
# ============================================================================
# Set in Vercel environment variables only - DO NOT commit actual keys
GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_ENTERPRISE_PROJECT_ID=your_recaptcha_project_id
RECAPTCHA_ENTERPRISE_API_KEY=your_recaptcha_enterprise_api_key
```

# ============================================================================
# EMAIL SENDING - PRIMARY: Gmail OAuth2 (Recommended)
# ============================================================================
# Gmail OAuth2 Configuration (Server-side only - CRITICAL: Don't expose)
# Get these from Google Cloud Console OAuth2 credentials setup
# See instructions in: get-oauth2-auth-url.js

GMAIL_CLIENT_ID=270610995591-44ljhomjib3d8j3qm0ccmatkc92obgq0.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here_keep_secure
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here_keep_secure
GMAIL_USER=navnit.alley@whiteboardconsultant.com
EMAIL_SERVICE=gmail-oauth2

# Admin Email (for contact form notifications)
ADMIN_EMAIL=info@whiteboardconsultant.com

# ============================================================================
# EMAIL SENDING - FALLBACK: SMTP2GO (Optional)
# ============================================================================
# Get these from: https://www.smtp2go.com/dashboard (Settings → SMTP Credentials)
# Leave commented out if using Gmail OAuth2 as primary service

# SMTP Server Configuration
# SMTP_HOST=mail.smtp2go.com
# SMTP_PORT=2525
# SMTP_SECURE=false

# SMTP2GO Credentials (MUST be kept secret - server-side only)
# SMTP_USER=your_production_smtp_username
# SMTP_PASSWORD=your_production_smtp_password_here
# SMTP_FROM_EMAIL=noreply@your-production-domain.com

# ============================================================================
# NEXT.JS & DEPLOYMENT CONFIGURATION
# ============================================================================

# Set to 'production' for production environment
NODE_ENV=production

# Analytics and monitoring
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# API Route Prefix
NEXT_PUBLIC_API_URL=https://your-production-domain.com/api

# ============================================================================
# OPTIONAL: Cloud Storage (if using external storage)
# ============================================================================
# Currently using Supabase Storage, but these can be added if needed

# AWS S3 (if applicable)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your_bucket_name

# ============================================================================
# OPTIONAL: Authentication Providers (if adding OAuth)
# ============================================================================
# These are commented out as optional - uncomment and configure if needed

# GitHub OAuth
# GITHUB_ID=your_github_oauth_id
# GITHUB_SECRET=your_github_oauth_secret

# Google OAuth
GOOGLE_CLIENT_ID=1087373984222-vf1pi9hadrltbckl9ooghdrb8okrag58.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================================
# OPTIONAL: Monitoring & Logging
# ============================================================================

# Sentry Error Tracking (if applicable)
